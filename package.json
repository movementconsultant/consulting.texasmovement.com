  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@types/node": "^26.2.0",
    "playwright-core": "^1.62.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
