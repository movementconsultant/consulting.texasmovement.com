---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Privacy"
  description="Privacy policy for Texas Movement Consulting. Full policy text is pending — this page states that plainly."
  path="/privacy"
>
  <section class="section">
    <div class="wrap">
      <div class="eyebrow">PRIVACY</div>
      <h1>Privacy policy.</h1>
      <div class="notice-panel">
        <p>
          <strong>Policy content pending.</strong> A full privacy policy for this site has not been written and
          published yet. This page is a placeholder so the link exists and says so honestly, rather than showing a
          broken link or a fabricated policy.
        </p>
        <p style="margin-top: 12px;">
          This is tracked as a launch blocker. Until a real policy is published here, treat this site as not having a
          reviewed privacy policy in place.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
