---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Terms"
  description="Terms of service for Texas Movement Consulting. Full terms text is pending — this page states that plainly."
  path="/terms"
>
  <section class="section">
    <div class="wrap">
      <div class="eyebrow">TERMS</div>
      <h1>Terms of service.</h1>
      <div class="notice-panel">
        <p>
          <strong>Policy content pending.</strong> Full terms of service for this site have not been written and
          published yet. This page is a placeholder so the link exists and says so honestly, rather than showing a
          broken link or fabricated terms.
        </p>
        <p style="margin-top: 12px;">
          This is tracked as a launch blocker. Until real terms are published here, no binding terms of service govern
          use of this site beyond ordinary law.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
