{
  "name": "@tmi/constants",
  "version": "1.0.0",
  "private": true,
  "description": "Single source of truth for the Texas Movement International ecosystem. Nothing in this package may be duplicated anywhere else in tmi-web.",
  "type": "module",
  "main": "./src/index.ts",
