    "./social": "./src/social.ts",
    "./seo": "./src/seo.ts",
    "./analytics": "./src/analytics.ts",
    "./editorial": "./src/editorial.ts",
    "./nav": "./src/nav.ts",
    "./utils": "./src/utils.ts"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "check:strict": "node scripts/check.mjs --strict",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
