# Copy to .env for local development.

# Preview / noindex convention (see docs/LAUNCH_BLOCKERS.md and the PR
# description). While true: every page ships `noindex, nofollow`, the sitemap
# is generated with zero indexable URLs, and canonical tags are omitted
# rather than pointing at the production domain unresolved.
#
# This MUST be "true" for this branch's build until a human explicitly flips
# it for a real production deploy.
PUBLIC_PREVIEW=true
